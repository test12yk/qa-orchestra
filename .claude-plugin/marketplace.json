{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "qa-orchestra",
  "description": "QA 오케스트라 플러그인 배포처",
  "owner": {
    "name": "test12yk"
  },
  "plugins": [
    {
      "name": "qa-orchestra",
      "description": "전체 묶음 (모든 에이전트)",
      "source": "./plugins/qa-orchestra",
      "category": "testing"
    },
    {
      "name": "qa-conductor",
      "description": "지휘자만 (/qa-conductor:conduct — 두 라인을 역할 순서대로 돌리고 사람 결정 지점에서 멈춤)",
      "source": "./plugins/qa-conductor",
      "category": "testing"
    },
    {
      "name": "qa-doc-collector",
      "description": "문서 수집가만",
      "source": "./plugins/qa-doc-collector",
      "category": "testing"
    },
    {
      "name": "qa-plan-analyst",
      "description": "기획 분석가만",
      "source": "./plugins/qa-plan-analyst",
      "category": "testing"
    },
    {
      "name": "qa-new-tc-writer",
      "description": "신규 TC 작성가만",
      "source": "./plugins/qa-new-tc-writer",
      "category": "testing"
    },
    {
      "name": "qa-bug-reporter",
      "description": "버그 리포터만 (지라 등록)",
      "source": "./plugins/qa-bug-reporter",
      "category": "testing"
    },
    {
      "name": "qa-new-automation",
      "description": "신규 기능 자동화만 (API 테스트 → TC 시트 결과)",
      "source": "./plugins/qa-new-automation",
      "category": "testing"
    },
    {
      "name": "qa-new-reviewer",
      "description": "신규 기능 검토자만 (실행 전 TC 검토 · 실행 결과 검토)",
      "source": "./plugins/qa-new-reviewer",
      "category": "testing"
    },
    {
      "name": "qa-new-judge",
      "description": "신규 기능 판정관만 (편입 추천·사람 결정 기록)",
      "source": "./plugins/qa-new-judge",
      "category": "testing"
    },
    {
      "name": "qa-new-reporter",
      "description": "신규 기능 QA 리포터만",
      "source": "./plugins/qa-new-reporter",
      "category": "testing"
    },
    {
      "name": "qa-reg-tc-manager",
      "description": "회귀 TC 관리자만",
      "source": "./plugins/qa-reg-tc-manager",
      "category": "testing"
    },
    {
      "name": "qa-reg-automation",
      "description": "회귀 자동화 관리자만 (회귀 API 테스트 → 회귀 실행 시트 결과)",
      "source": "./plugins/qa-reg-automation",
      "category": "testing"
    },
    {
      "name": "qa-reg-reviewer",
      "description": "회귀 검토자만 (회귀 Fail 원인·운영 결함 원인 분석)",
      "source": "./plugins/qa-reg-reviewer",
      "category": "testing"
    },
    {
      "name": "qa-release-judge",
      "description": "릴리즈 판정관만 (배포 Go/No-Go 추천·기능 빼면 재회귀 범위·사람 결정 기록)",
      "source": "./plugins/qa-release-judge",
      "category": "testing"
    },
    {
      "name": "qa-release-reporter",
      "description": "릴리즈 QA 리포터만 (한 장 릴리즈 리포트·컨플루언스)",
      "source": "./plugins/qa-release-reporter",
      "category": "testing"
    }
  ]
}
